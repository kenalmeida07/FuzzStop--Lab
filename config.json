
{
  "experiment": {
    "name": "FuzzStop-Lab",
    "type": "simulation",
    "random_seed": 42,
    "campaigns": 100,
    "maximum_executions": 10000
  },
  "stopping_criteria": {
    "fixed_budget": {
      "enabled": true
    },
    "zero_discovery": {
      "enabled": true,
      "consecutive_zero_limit": 1000
    },
    "trend_based": {
      "enabled": true,
      "window_size": 500,
      "discovery_rate_ratio": 0.1
    }
  },
  "scenarios": {
    "fast_decay": {
      "initial_probability": 0.08,
      "decay": 0.0008
    },
    "slow_decay": {
      "initial_probability": 0.04,
      "decay": 0.0001
    },
    "intermittent": {
      "initial_probability": 0.04,
      "decay": 0.0002,
      "burst_probability": 0.15,
      "burst_discovery_probability": 0.20
    }
  }
}
